{
  "name": "towers-and-runes",
  "version": "1.0.0",
  "private": true,
  "description": "Башни и руны — браузерная карточная стратегия с ботами и сетевыми дуэлями",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node scripts/playtest.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.towersandrunes.game",
    "productName": "Башни и руны",
    "files": [
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
